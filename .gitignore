# ==============================================================================
# Git Ignore Rules — Cyclone Impact Forecaster (ZATICS v3.0)
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SENSITIVE API KEYS)
# Ignore every real environment file. Keep only the documented template.
.env*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
id_rsa
id_ed25519
*.token
*.tokens
*.bak
api/gee-credentials.json
*credentials*.json
!api/gee-credentials.example.json

# Local SQLite Databases & Volatile Runtime Data
*.db
*.sqlite
*.sqlite3
backend/cyclone_forecaster.db

# Python Bytecode, Caches & Packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
docs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Agent IDE & System Logs
.agents/
.gemini/
.system_generated/
*.log

# Editor & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Node / Frontend Artifacts (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.parcel-cache/
.next/
out/
