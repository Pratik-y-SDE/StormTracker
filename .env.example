# ==============================================================================
# Environment Configuration — Cyclone Impact Forecaster (ZATICS v3.0)
# ==============================================================================

# 1. Google Gemini AI API Key (Required for AI Advisories, Executive Briefings, & Multilingual Copilot)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Port (Optional, defaults to 8000)
PORT=8000

# 2a. Security settings (required for any operational write or AI-generation API)
# Generate a long random value, store it in your deployment secret manager, and
# send it only from a trusted server/admin interface as the X-Admin-API-Key header.
ADMIN_API_KEY=replace_with_a_long_random_secret
# Comma-separated browser origins permitted to call this API. Do not use *.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Public citizen-copilot requests permitted per source IP per hour.
PUBLIC_AI_RATE_LIMIT=10

# 3. Google Earth Engine (GEE) Service Account (Optional for live Earth Engine assets)
# Place your service account JSON file at api/gee-credentials.json
GEE_SERVICE_ACCOUNT=earth-engine-service@your-project-id.iam.gserviceaccount.com
GEE_PROJECT_ID=your-project-id
GEE_PRIVATE_KEY_PATH=api/gee-credentials.json

# 4. Optional Third-Party Alerting & Map Gateways
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# WEATHER_API_KEY=your_weather_api_key_here
# SMS_GATEWAY_API_KEY=your_sms_gateway_key_here
